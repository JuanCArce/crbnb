{
  "name": "@crbnb/source",
  "version": "0.1.0",
  "description": "CRBNB — Plataforma de bookings con bajas comisiones para hosts (Costa Rica MVP)",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "nx serve web",
    "start:admin": "nx serve admin",
    "build": "nx run-many -t build",
    "build:web": "nx build web",
    "build:admin": "nx build admin",
    "test": "nx run-many -t test",
    "test:web": "nx test web",
    "lint": "nx run-many -t lint",
    "e2e": "nx run-many -t e2e",
    "extract-i18n": "nx extract-i18n web",
    "db:types": "pnpm dlx supabase gen types typescript --local > packages/data-access/src/lib/supabase/database.types.ts",
    "db:migrate:local": "pnpm dlx supabase db reset --local",
    "db:diff": "pnpm dlx supabase db diff -f",
    "worker:dev": "cd infra/cloudflare && pnpm dlx wrangler dev",
    "worker:deploy": "cd infra/cloudflare && pnpm dlx wrangler deploy",
    "affected": "nx affected",
    "graph": "nx graph"
  },
