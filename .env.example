# =============================================================
# CRBNB — Variables de entorno (ejemplo)
# Copiar a .env y completar valores reales
# =============================================================

# -------------------------------------------
# Supabase
# -------------------------------------------
# URL del proyecto (formato: https://<project-ref>.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Clave anon (pública, expuesta al browser)
SUPABASE_ANON_KEY=eyJ...

# Clave service_role (SOLO server-side, NUNCA al browser)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ID del proyecto (para db:types y CLI)
SUPABASE_PROJECT_ID=your-project-ref

# -------------------------------------------
# Cloudflare
# -------------------------------------------
CLOUDFLARE_API_TOKEN=...
CLOUDFLARE_ACCOUNT_ID=...

# URL del origen Angular SSR (para el Worker)
ORIGIN_URL=https://crbnb-web.pages.dev

# -------------------------------------------
# Email (Resend)
# -------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@crbnb.com

# -------------------------------------------
# Mapas (MapTiler)
# -------------------------------------------
# Free tier: 100k tile requests/mes. https://maptiler.com/
MAPTILER_KEY=...

# -------------------------------------------
# Pagos (producción)
# -------------------------------------------
# Tylopay
TYLOPAY_API_KEY=...
TYLOPAY_WEBHOOK_SECRET=...

# Onvo
ONVO_API_KEY=...
ONVO_WEBHOOK_SECRET=...

# -------------------------------------------
# Calendar (Google OAuth)
# -------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=...
GOOGLE_OAUTH_CLIENT_SECRET=...

# -------------------------------------------
# App
# -------------------------------------------
APP_BASE_URL=http://localhost:4200
NODE_ENV=development